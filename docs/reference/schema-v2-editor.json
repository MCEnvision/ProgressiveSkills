          "example": "Physique skill icon",
          "diagnostic": "PS-A11Y-001",
          "editor": {
            "widget": "component",
            "group": "core",
            "order": 50,
            "help": "Optional narration text; defaults to the alt component."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": true
        },
        {
          "path": "type",
          "type": "enum",
