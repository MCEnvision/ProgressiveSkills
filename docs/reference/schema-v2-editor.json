          "allowed_values": ["item", "block", "texture", "atlas_sprite", "player_head", "entity_preview", "cycling_tag", "composite_badge"],
          "default": null,
          "description": "Tagged icon descriptor kind.",
          "example": "item",
          "diagnostic": "PS-SCHEMA-006",
          "editor": {
            "widget": "select",
            "group": "core",
            "order": 10,
            "help": "Tagged icon descriptor kind."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "value",
          "type": "resource_location",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Single namespaced registry, texture, tag, or typed pack-spec identity.",
          "example": "minecraft:iron_chestplate",
          "diagnostic": "PS-SCHEMA-006",
          "editor": {
            "widget": "resource_location",
            "group": "core",
            "order": 20,
            "help": "Single namespaced registry, texture, tag, or typed pack-spec identity."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "values",
          "type": "list",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Ordered layer references used only by composite badges.",
          "example": "[\"mypack:base\", \"mypack:badge\"]",
          "diagnostic": "PS-SCHEMA-006",
          "editor": {
            "widget": "list",
            "group": "core",
            "order": 25,
            "help": "Ordered layer references used only by composite badges."
          },
          "projection": "client_visible",
          "diff": "ordered",
          "omit_when_default": false
        }
      ],
      "constraints": [
        {
          "type": "exactly_one",
          "trigger": null,
          "fields": ["value", "values"],
          "diagnostic": "PS-SCHEMA-006",
          "description": "Use value for a single/tag identity or values for composite badge layers."
        }
      ]
    },
