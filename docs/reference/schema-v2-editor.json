    {
      "id": "progressiveskills:alias",
      "version": 2,
      "audience": "authoring",
      "title": "Definition alias",
      "description": "A same-kind old identity mapped to one canonical replacement identity.",
      "fields": [
        {
          "path": "kind",
          "type": "resource_location",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Definition kind shared by the old and replacement identities.",
          "example": "progressiveskills:skill",
          "diagnostic": "PS-ID-003",
          "editor": {
            "widget": "resource_location",
            "group": "core",
            "order": 10,
            "help": "Definition kind shared by the old and replacement identities."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "new_id",
          "type": "resource_location",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Canonical replacement identity.",
          "example": "mypack:combat/physique",
          "diagnostic": "PS-ID-003",
          "editor": {
            "widget": "resource_location",
            "group": "core",
            "order": 30,
            "help": "Canonical replacement identity."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "old_id",
          "type": "resource_location",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Retired identity retained for migration and reference resolution.",
          "example": "mypack:combat/strength",
          "diagnostic": "PS-ID-003",
          "editor": {
            "widget": "resource_location",
            "group": "core",
            "order": 20,
            "help": "Retired identity retained for migration and reference resolution."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        }
      ],
      "constraints": [
      ]
    },
    {
      "id": "progressiveskills:canonical_definition",
      "version": 2,
      "audience": "internal",
      "title": "Canonical definition envelope",
      "description": "Immutable typed semantic fields paired with source maps and provenance.",
      "fields": [
        {
          "path": "fields",
          "type": "map",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Deterministically ordered typed canonical values.",
          "example": "{ max_level = 100 }",
          "diagnostic": "PS-SCHEMA-005",
          "editor": {
            "widget": "object",
            "group": "core",
            "order": 20,
            "help": "Deterministically ordered typed canonical values."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "header",
          "type": "object",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Schema version, typed stable key, and safe presentation.",
          "example": "{ schema_version = 2, id = \"mypack:physique\" }",
          "diagnostic": "PS-SCHEMA-005",
          "editor": {
            "widget": "object",
            "group": "core",
            "order": 10,
            "help": "Schema version, typed stable key, and safe presentation."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "provenance",
          "type": "object",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Adapter and source metadata excluded from semantic projection.",
          "example": "{ adapter = \"toml\" }",
          "diagnostic": "PS-SCHEMA-004",
          "editor": {
            "widget": "object",
            "group": "core",
            "order": 30,
            "help": "Adapter and source metadata excluded from semantic projection."
          },
          "projection": "server_only",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "source_map",
          "type": "map",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Field path to source-span mapping excluded from semantic projection.",
          "example": "{ max_level = { source = \"skills/physique.toml\" } }",
          "diagnostic": "PS-SCHEMA-004",
          "editor": {
            "widget": "key_value",
            "group": "core",
            "order": 40,
            "help": "Field path to source-span mapping excluded from semantic projection."
          },
          "projection": "server_only",
          "diff": "merge_by_key",
          "omit_when_default": false
        }
      ],
      "constraints": [
      ]
    },
    {
      "id": "progressiveskills:component_spec",
      "version": 2,
      "audience": "authoring",
      "title": "Component specification",
      "description": "Safe localized text descriptor stored in IR instead of a mutable vanilla Component.",
      "fields": [
        {
          "path": "children",
          "type": "list",
          "required": false,
          "allowed_values": [],
          "default": [],
          "description": "Bounded child component specifications rendered in order.",
          "example": "[{ fallback = \"!\", style = { color = \"gold\" } }]",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "list",
            "group": "core",
            "order": 50,
            "help": "Bounded child component specifications rendered in order."
          },
          "projection": "client_visible",
          "diff": "ordered",
          "omit_when_default": true
        },
        {
          "path": "fallback",
          "type": "string",
          "required": true,
          "allowed_values": [],
          "default": null,
          "description": "Bounded text used when a locale key cannot be resolved.",
          "example": "Physique",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "multi_line",
            "group": "core",
            "order": 20,
            "help": "Bounded text used when a locale key cannot be resolved."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "key",
          "type": "string",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Pack locale key; omission creates a literal safe component.",
          "example": "skill.mypack.physique",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "single_line",
            "group": "core",
            "order": 10,
            "help": "Pack locale key; omission creates a literal safe component."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "placeholders",
          "type": "map",
          "required": false,
          "allowed_values": [],
          "default": {},
          "description": "Stable placeholder names mapped to declared value types.",
          "example": "{ level = \"integer\", skill = \"component\" }",
          "diagnostic": "PS-I18N-002",
          "editor": {
            "widget": "key_value",
            "group": "core",
            "order": 30,
            "help": "Stable placeholder names mapped to declared value types."
          },
          "projection": "client_visible",
          "diff": "merge_by_key",
          "omit_when_default": true
        },
        {
          "path": "style",
          "type": "object",
          "required": false,
          "allowed_values": [],
          "default": {},
          "description": "Allowlisted, non-interpreting text style.",
          "example": "{ color = \"red\", bold = true }",
          "diagnostic": "PS-SEC-001",
          "editor": {
            "widget": "object",
            "group": "core",
            "order": 40,
            "help": "Allowlisted, non-interpreting text style."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": true
        }
      ],
      "constraints": [
      ]
    },
    {
      "id": "progressiveskills:definition_header",
      "version": 2,
      "audience": "authoring",
      "title": "Definition header",
      "description": "Versioned identity and presentation fields shared by every definition.",
      "fields": [
        {
          "path": "description",
          "type": "component",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Localized long-form description.",
          "example": "{ key = \"skill.mypack.physique.desc\", fallback = \"Raw power.\" }",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "component",
            "group": "core",
            "order": 40,
            "help": "Localized long-form description."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "display",
          "type": "component",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Localized player-facing display name.",
          "example": "{ key = \"skill.mypack.physique\", fallback = \"Physique\" }",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "component",
            "group": "core",
            "order": 30,
            "help": "Localized player-facing display name."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "icon",
          "type": "icon",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Typed icon descriptor with required fallback and alternative text.",
          "example": "{ type = \"item\", value = \"minecraft:iron_chestplate\", fallback = \"minecraft:barrier\", alt = \"Iron chestplate\" }",
          "diagnostic": "PS-A11Y-001",
          "editor": {
            "widget": "icon",
            "group": "core",
            "order": 50,
            "help": "Typed icon descriptor with required fallback and alternative text."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "id",
          "type": "resource_location",
          "required": false,
          "allowed_values": [],
          "default": null,
          "description": "Stable typed identity; when written explicitly it must match the source-derived id.",
          "example": "mypack:combat/physique",
          "diagnostic": "PS-ID-002",
          "editor": {
            "widget": "resource_location",
            "group": "core",
            "order": 20,
            "help": "Stable typed identity; when written explicitly it must match the source-derived id."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "schema_version",
          "type": "integer",
          "required": true,
          "allowed_values": ["2"],
          "default": null,
          "description": "Authoring schema version compiled into the canonical IR.",
          "example": "2",
          "diagnostic": "PS-SCHEMA-001",
          "editor": {
            "widget": "integer",
            "group": "core",
            "order": 10,
            "help": "Authoring schema version compiled into the canonical IR."
          },
          "projection": "client_visible",
          "diff": "replace",
          "omit_when_default": false
        },
        {
          "path": "search_aliases",
          "type": "list",
          "required": false,
          "allowed_values": [],
          "default": [],
          "description": "Bounded, normalized alternate terms used by presentation search.",
          "example": "[\"Strength\", \"Might\"]",
          "diagnostic": "PS-I18N-001",
          "editor": {
            "widget": "list",
            "group": "core",
            "order": 60,
            "help": "Bounded, normalized alternate terms used by presentation search."
          },
          "projection": "client_visible",
          "diff": "set",
          "omit_when_default": true
        }
      ],
      "constraints": [
        {
          "type": "required_together",
          "trigger": null,
          "fields": ["display", "icon"],
          "diagnostic": "PS-I18N-001",
          "description": "Display and icon are either both present or both omitted."
        },
        {
          "type": "requires",
          "trigger": "description",
          "fields": ["display", "icon"],
          "diagnostic": "PS-I18N-001",
          "description": "A description is presentation metadata and requires display plus icon."
        },
        {
          "type": "requires",
          "trigger": "search_aliases",
          "fields": ["display", "icon"],
          "diagnostic": "PS-I18N-001",
          "description": "Non-default search aliases require display plus icon."
        }
      ]
    },
    {
      "id": "progressiveskills:icon_spec",
      "version": 2,
      "audience": "authoring",
